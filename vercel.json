{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "git config --global url.https://github.com/.insteadOf ssh://git@github.com/ && git config --global url.https://github.com/.insteadOf git@github.com: && npm install",
  "buildCommand": "npm run build",
  "outputDirectory": "build/client",
  "rewrites": [
    { "source": "/trust", "destination": "/trust/index.html" },
    { "source": "/privacy", "destination": "/privacy/index.html" },
    { "source": "/terms", "destination": "/terms/index.html" },
    { "source": "/((?!assets/|api/).*)", "destination": "/index.html" }
  ]
}
