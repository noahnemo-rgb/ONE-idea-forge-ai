# Idea Forge — preview / local. Copy to .env and fill only what you need.
# Never commit a filled .env. Preview does not need live Stripe.

# Web origin for this deployment (Vercel sets URL; override if the stamp links break)
# APP_ORIGIN=https://your-preview.vercel.app

# Neon — omit on first Preview. API and account routes will fail closed.
# DATABASE_URL=postgresql://USER:PASS@HOST/DB?sslmode=require

# Auth.js — generate a random string for a real preview session later
# AUTH_SECRET=

# CORS — comma-separated origins if the API is called from another host
# CORS_ORIGINS=https://your-preview.vercel.app

# Stripe — keep empty on Preview
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_ID=

# Guest inference (BYOK / product env). Not invited until HITL says so.
# OPENROUTER_API_KEY=
