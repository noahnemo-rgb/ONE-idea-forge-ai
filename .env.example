# Idea Forge — preview / local. Copy to .env and fill only what you need.
# Never commit a filled .env. Preview does not need live Stripe.

# Web origin for this deployment (Vercel sets URL; override if the stamp links break)
# APP_ORIGIN=https://your-preview.vercel.app

# Neon — required for accounts, saved ideas, community, and chat history.
# Account cookies do not need AUTH_SECRET. Omit DATABASE_URL and those routes fail closed.
# DATABASE_URL=postgresql://USER:PASS@HOST/DB?sslmode=require

# Auth.js — only for the older /api/auth/* actions. The email account system does not use it.
# AUTH_SECRET=

# CORS — comma-separated origins if the API is called from another host
# CORS_ORIGINS=https://your-preview.vercel.app

# Stripe — checkout and the webhook stay off until both secrets are set.
# STRIPE_PRICE_ID optional; without it checkout uses a $19/month price.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_ID=

# Server AI guests. Names only. Values stay in this repo's .env or the Vercel project.
# The browser calls server/forge/ai-proxy.js. That file checks Origin and the provider/model allowlist, then reads the key.
# Do not put these in website JavaScript, localStorage, or sessionStorage.
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=
# AI_GATEWAY_API_KEY=
# VERCEL_OIDC_TOKEN=
# AI_GATEWAY_MODEL=
# GEMINI_API_KEY=
# GEMINI_MODEL=
# LLM_API_KEY=
# LLMAPI_MODEL=
# NVIDIA_API_KEY=
# NVIDIA_MODEL=
# AI_BUFFER_VAULT_KEY= is not read. This app does not mount the web vault.

# Partner Gift cashier (Idea Forge only; do not reuse on other products)
# PARTNER_DAILY_SIP_CAP=3
# FORGE_VISITOR_PUTER=0
# OPENROUTER_DONOR_01=
# OPENROUTER_DONOR_02=
# OPENROUTER_DONOR_03=
# OPENROUTER_DONOR_04=
# OPENROUTER_DONOR_05=
# OPENROUTER_DONOR_06=
# OPENROUTER_DONOR_07=
# OPENROUTER_DONOR_08=
# OPENROUTER_DONOR_09=
# OPENROUTER_DONOR_10=
# Puter coats documented, not wired in P013.
# PUTER_DONOR_01=
# Sequencer does not use OPENROUTER_API_KEY.
